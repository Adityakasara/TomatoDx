{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train TomatoDx Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/tomatodx_train.py",
      "args": [
        "--data_dir", "./data/tomato",
        "--epochs", "40",
        "--batch_size", "32",
        "--output_dir", "./outputs"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Inference",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/tomatodx_inference.py",
      "args": [
        "--model_path", "./outputs/tomatodx_best.keras",
        "--image_path", "${input:imagePath}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Grad-CAM",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/tomatodx_gradcam.py",
      "args": [
        "--model_path", "./outputs/tomatodx_best.keras",
        "--image_path", "${input:imagePath}",
        "--output_path", "./outputs/gradcam_overlay.png"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "imagePath",
      "type": "promptString",
      "description": "Path to the leaf image file",
      "default": "./data/sample_leaf.jpg"
    }
  ]
}
